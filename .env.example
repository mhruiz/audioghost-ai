# AudioGhost AI - Configuration

# HuggingFace Token (Get one at https://huggingface.co/settings/tokens)
# You must have access to facebook/sam-audio-large
HF_TOKEN=your_token_here

# Auto-preload model on worker startup (optional)
# Options: small, base, large (leave empty to disable)
PRELOAD_MODEL=

# Redis Configuration (Optional, defaults should work in Docker)
# REDIS_URL=redis://redis_docker:6379/0
